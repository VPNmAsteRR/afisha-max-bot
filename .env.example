# --- Платформа MAX ---
# Токен бота из карточки «Чат-боты» → «...» → «Настройки» → «Получить токен»
BOT_TOKEN=вставьте_токен_сюда
API_BASE=https://platform-api2.max.ru
API_VERSION=0.1.5

# --- Вебхук (рабочий режим) ---
# Публичный адрес сервера с HTTPS. Если пусто — включится Long Polling (только для разработки)
WEBHOOK_URL=
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=придумайте_длинную_строку

# --- Сервер ---
HOST=0.0.0.0
PORT=8080

# --- Google Таблица ---
# ID берётся из адреса таблицы: docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=Афиша
# Путь к JSON-ключу сервисного аккаунта
GOOGLE_CREDENTIALS=/opt/afisha/credentials.json
SHEET_REFRESH_SECONDS=60

# --- Данные ---
DATA_DIR=/opt/afisha/data

# --- Администрирование ---
# Не более 3 ID через запятую. ID пользователя MAX — числовой идентификатор.
ADMIN_IDS=
# Служебный чат для сводок и уведомлений о сбоях
ADMIN_CHAT_ID=

# --- Поведение ---
TIMEZONE=Asia/Krasnoyarsk
DAILY_DIGEST_HOUR=9
BACKUP_HOUR=3
LOG_LEVEL=INFO
